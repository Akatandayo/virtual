    "controller.animation.sophia.aura": {
      "initial_state": "none",
      "states": {
        "none": {
          "transitions": [
            {
              "a3": "q.skin_id >= 3"
            },
            {
              "a2": "q.skin_id == 2"
            },
            {
              "a1": "q.skin_id == 1"
            }
          ]
        },
        "a1": {
          "animations": [
            "aura_1"
          ],
          "transitions": [
            {
              "a2": "q.skin_id >= 2"
            },
            {
              "none": "!q.is_alive"
            }
          ]
        },
        "a2": {
          "animations": [
            "aura_2"
          ],
          "transitions": [
            {
              "a3": "q.skin_id >= 3"
            },
            {
              "none": "!q.is_alive"
            }
          ]
        },
        "a3": {
          "animations": [
            "aura_3"
          ],
          "transitions": [
            {
              "none": "!q.is_alive"
            }
          ]
        }
      }
    },
    "controller.animation.sophia.attack_fx": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "swing_0": "variable.attack_time > 0.25 && math.mod(v.atk_n, 3) == 0"
            },
            {
              "swing_1": "variable.attack_time > 0.25 && math.mod(v.atk_n, 3) == 1"
            },
            {
              "swing_2": "variable.attack_time > 0.25"
            }
          ]
        },
        "swing_0": {
          "transitions": [
            {
              "ready": "variable.attack_time < 0.2"
            }
          ]
        },
        "swing_1": {
          "transitions": [
            {
              "ready": "variable.attack_time < 0.2"
            }
          ]
        },
        "swing_2": {
          "transitions": [
            {
              "ready": "variable.attack_time < 0.2"
            }
          ]
        }
      }
    }
  }
}