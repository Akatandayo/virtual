{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "sophia:galaxy",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/sophia_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 400,
        "max_particles": 700
      },
      "minecraft:emitter_lifetime_once": {
