    "controller.animation.sophia.barrier_cd": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "cd": "q.is_sheared"
            }
          ]
        },
        "cd": {
          "animations": [
            "cd_timer"
          ],
          "transitions": [
            {
              "ready": "q.all_animations_finished || !q.is_sheared"
            }
          ],
          "on_exit": [
            "@s sophia:barrier_cd_end"
          ]
        }
      }
    },
    "controller.animation.sophia.barrier_time": {
      "initial_state": "off",
      "states": {
        "off": {
          "transitions": [
            {
              "on": "q.is_charged"
            }
          ]
        },
        "on": {
          "animations": [
            "barrier_timer"
          ],
          "transitions": [
            {
              "off": "q.all_animations_finished || !q.is_charged"
            }
          ],
          "on_exit": [
            "@s sophia:barrier_end"
          ]
        }
      }
    },
    "controller.animation.sophia.death": {
      "initial_state": "alive",
      "states": {
        "alive": {
          "transitions": [
            {
              "dead": "!q.is_alive"
            }
          ]
        },
        "dead": {
          "on_entry": [
            "/summon sophia:director ~ ~ ~",
            "/fog @a[r=64] remove sophia_universe",
            "/tag @a remove sophia_stopped",
            "/tag @a remove sophia_gazed",
            "/camera @a[tag=sophia_cine] clear",
            "/hud @a[tag=sophia_cine] reset all",
            "/tag @a[tag=sophia_cine] remove sophia_cine"
          ]
        }
      }
    },
    "controller.animation.sophia.orb": {
      "initial_state": "pick",
      "states": {
        "pick": {
          "transitions": [
            {
              "slow": "q.variant == 1"
            },
            {
              "normal": "q.variant == 2"
            },
            {
              "fast": "q.variant == 3"
            }
          ]
        },
        "slow": {
          "animations": [
            "slow"
          ]
        },
        "normal": {
          "animations": [
            "normal"
          ]
        },
        "fast": {
          "animations": [
            "fast"
          ]
        }
      }
    },
    "controller.animation.sophia.funnel": {
      "initial_state": "hover",
      "states": {
        "hover": {
          "animations": [
            "hover"
          ],
          "transitions": [
            {
              "home": "q.all_animations_finished"
            }
          ]
        },
        "home": {
          "animations": [
            "home"
          ],
          "transitions": [
            {
              "fly": "q.all_animations_finished"
            }
          ],
          "on_entry": [
            "/playsound item.trident.throw @a[r=30] ~ ~ ~ 0.6 1.6"
          ]
        },
        "fly": {
          "animations": [
            "fly"
          ]
        }
      }
    }
  }
