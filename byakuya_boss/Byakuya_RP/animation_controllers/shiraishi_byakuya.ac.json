    "controller.animation.byakuya.aura": {
      "initial_state": "none",
      "states": {
        "none": {
          "transitions": [
            {
              "final": "q.skin_id >= 2"
            },
            {
              "aura": "q.skin_id == 1"
            }
          ]
        },
        "aura": {
          "animations": [
            "aura"
          ],
          "transitions": [
            {
              "final": "q.skin_id >= 2"
            },
            {
              "none": "!q.is_alive"
            }
          ]
        },
        "final": {
          "animations": [
            "final_aura"
          ],
          "transitions": [
            {
              "none": "!q.is_alive"
            }
          ]
        }
      }
