    "controller.animation.byakuya.attack_fx": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "swing": "variable.attack_time > 0.25"
            }
          ]
        },
        "swing": {
          "particle_effects": [
            {
              "effect": "sword_trail",
              "locator": "right_hand"
            }
          ],
          "transitions": [
            {
              "ready": "variable.attack_time <= 0.0 || variable.attack_time < 0.2"
