{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "byakuya:ripple_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/byakuya_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 500,
        "max_particles": 600
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.8
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "math.cos(v.particle_random_1 * 360) * (1.5 + v.emitter_age * 10)",
          "0.05",
          "math.sin(v.particle_random_1 * 360) * (1.5 + v.emitter_age * 10)"
        ],
        "direction": [
          0,
          1,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.18"
      },
      "minecraft:particle_initial_speed": "math.random(1, 3)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 * (1 - v.particle_age / v.particle_lifetime) + 0.04",
          "0.16 * (1 - v.particle_age / v.particle_lifetime) + 0.04"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": "#FFFFFFFF",
            "0.50": "#FFFF3020",
            "1.00": "#00600000"
          }
        }
      }
    }
  }
}