{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "byakuya:leaf_swirl",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/byakuya_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 70,
        "max_particles": 90
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.4
      },
      "minecraft:emitter_shape_point": {
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "1.2"
      },
      "minecraft:particle_motion_parametric": {
        "relative_position": [
          "math.cos(v.particle_age * 450 + v.particle_random_1 * 360) * (3 - v.particle_age * 2)",
          "v.particle_age * 1.5 + v.particle_random_2",
          "math.sin(v.particle_age * 450 + v.particle_random_1 * 360) * (3 - v.particle_age * 2)"
        ]
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.16 * (1 - v.particle_age / v.particle_lifetime)",
          "0.16 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          0.35,
          1.0,
          0.4,
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}