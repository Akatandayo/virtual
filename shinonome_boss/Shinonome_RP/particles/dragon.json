{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "shinonome:dragon",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/toa_glow"
      }
    },
    "components": {
      "minecraft:emitter_rate_instant": {
        "num_particles": 6
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 0.1
      },
      "minecraft:emitter_shape_sphere": {
        "radius": 0.5,
        "surface_only": false,
        "direction": "outwards",
        "offset": [
          0,
          0,
          0
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "math.random(0.4, 0.8)"
      },
      "minecraft:particle_initial_speed": "math.random(0.3, 1.2)",
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          1.5,
          0
        ],
        "linear_drag_coefficient": 0.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.55 * (1 - v.particle_age / v.particle_lifetime)",
          "0.55 * (1 - v.particle_age / v.particle_lifetime)"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": {
          "interpolant": "v.particle_age / v.particle_lifetime",
          "gradient": {
            "0.00": "#FFFFF0A0",
            "0.33": "#FFFF7020",
            "0.67": "#FFC01808",
            "1.00": "#00400000"
          }
        }
      }
    }
  }
}