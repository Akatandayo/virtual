{
  "format_version": "1.10.0",
  "animations": {
    "animation.toa.react": {
      "loop": true,
      "bones": {
        "root": {
          "scale": [
            "1 + v.react * 0.18",
            "1 - v.react * 0.22",
            "1 + v.react * 0.18"
          ]
        }
      }
    },
    "animation.toa.desperate": {
      "loop": true,
      "animation_length": 0.3,
      "particle_effects": {
        "0.00": [
          {
            "effect": "desperate",
            "locator": "right_foot"
          }
        ],
        "0.15": [
          {
            "effect": "desperate",
            "locator": "left_foot"
          }
        ]
      }
    },
    "animation.toa.pant": {
      "loop": true,
      "bones": {
        "body": {
          "rotation": [
            "5 + math.sin(q.life_time * 260) * 3",
            0,
            0
          ]
        },
        "head": {
          "rotation": [
            "9 + math.sin(q.life_time * 260 + 40) * 2.5",
            0,
            0
          ]
        },
        "rightArm": {
          "rotation": [
            "math.sin(q.life_time * 260) * 2",
            0,
            "math.sin(q.life_time * 260) * 2"
          ]
        },
        "leftArm": {
          "rotation": [
            "math.sin(q.life_time * 260) * 2",
            0,
            "-math.sin(q.life_time * 260) * 2"
          ]
        }
      }
    }
  }
}