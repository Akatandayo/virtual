    "controller.animation.toa.death": {
      "initial_state": "alive",
      "states": {
        "alive": {
          "transitions": [
            {
              "dead": "!q.is_alive"
            }
          ]
        },
        "dead": {
          "on_entry": [
            "/summon shinonome:director ~ ~ ~",
            "/fog @a[r=64] remove toa_timestop",
            "/tag @a remove toa_frozen",
            "/tag @a remove toa_chained",
            "/tag @a remove toa_oiled",
            "/event entity @e[family=toa_clone] shinonome:poof",
            "/camera @a[tag=toa_cine] clear",
            "/hud @a[tag=toa_cine] reset all",
            "/tag @a[tag=toa_cine] remove toa_cine"
          ]
        }
