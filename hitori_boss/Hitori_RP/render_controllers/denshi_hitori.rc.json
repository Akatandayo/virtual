{
  "format_version": "1.10.0",
  "render_controllers": {
    "controller.render.denshi_hitori": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "overlay_color": {
        "r": "v.load >= 2 ? 1.0 : (math.random(0, 1) > 0.5 ? 0.0 : 1.0)",
        "g": "v.load >= 2 ? 0.1 : (math.random(0, 1) > 0.5 ? 1.0 : 0.0)",
        "b": "v.load >= 2 ? 0.15 : 1.0",
        "a": "(q.mark_variant != 99 && math.mod(math.floor(q.life_time * (9 + v.load * 5)), math.max(2, (q.skin_id >= 1 ? 4 : 7) - v.load * 2)) == 0) ? 0.45 + v.load * 0.1 : 0.0"
      },
      "uv_anim": {
        "offset": [
          "(q.mark_variant != 99 && math.mod(math.floor(q.life_time * 11), math.max(2, (q.skin_id >= 1 ? 5 : 9) - v.load * 3)) == 0) ? math.random(-0.06, 0.06) * (1 + v.load * 0.5) : 0.0",
          "0.0"
        ],
        "scale": [
          1.0,
          1.0
        ]
      }
    },
    "controller.render.hitori_echo": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ],
      "overlay_color": {
        "r": "0.2",
        "g": "1.0",
        "b": "1.0",
        "a": "0.55 + math.random(0, 0.25)"
      }
    },
    "controller.render.hitori_simple": {
      "geometry": "Geometry.default",
      "materials": [
        {
          "*": "Material.default"
        }
      ],
      "textures": [
        "Texture.default"
      ]
    }
  }
}