          "0.05 + v.particle_random_2 * 0.5",
          "0.06"
        ],
        "facing_camera_mode": "lookat_xyz",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_1 > 0.5 ? 0.0 : 0.05",
          "v.particle_random_1 > 0.5 ? 0.9 : 0.0",
          "v.particle_random_1 > 0.5 ? 1.0 : 0.05",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
