{
  "format_version": "1.10.0",
  "particle_effect": {
    "description": {
      "identifier": "hitori:aurora_ring",
      "basic_render_parameters": {
        "material": "particles_add",
        "texture": "textures/particle/hitori_aurora"
      }
    },
    "components": {
      "minecraft:emitter_rate_steady": {
        "spawn_rate": 260,
        "max_particles": 500
      },
      "minecraft:emitter_lifetime_once": {
        "active_time": 1.4
      },
      "minecraft:emitter_shape_custom": {
        "offset": [
          "math.cos(v.particle_random_1 * 360) * (2 + v.emitter_age * 13)",
          "0",
          "math.sin(v.particle_random_1 * 360) * (2 + v.emitter_age * 13)"
        ]
      },
      "minecraft:particle_lifetime_expression": {
        "max_lifetime": "0.6"
      },
      "minecraft:particle_initial_speed": 1.5,
      "minecraft:particle_motion_dynamic": {
        "linear_acceleration": [
          0,
          0,
          0
        ],
        "linear_drag_coefficient": 0.0
      },
      "minecraft:particle_appearance_billboard": {
        "size": [
          "0.5",
          "3.5 * (1 - v.particle_age / v.particle_lifetime) + 0.5"
        ],
        "facing_camera_mode": "lookat_y",
        "uv": {
          "texture_width": 1,
          "texture_height": 1,
          "uv": [
            0,
            0
          ],
          "uv_size": [
            1,
            1
          ]
        }
      },
      "minecraft:particle_appearance_tinting": {
        "color": [
          "v.particle_random_2 < 0.33 ? 0.2 : (v.particle_random_2 < 0.66 ? 0.3 : 0.7)",
          "v.particle_random_2 < 0.33 ? 1.0 : (v.particle_random_2 < 0.66 ? 0.8 : 0.3)",
          "v.particle_random_2 < 0.33 ? 0.5 : 1.0",
          "1 - v.particle_age / v.particle_lifetime"
        ]
      }
    }
  }
}