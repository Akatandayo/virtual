    "controller.animation.hitori.aura": {
      "initial_state": "light",
      "states": {
        "light": {
          "animations": [
            "aura"
          ],
          "transitions": [
            {
              "off": "q.mark_variant == 99 || !q.is_alive"
            },
            {
              "heavy": "q.skin_id >= 1"
            }
          ]
        },
        "heavy": {
          "animations": [
            "aura_heavy"
          ],
          "transitions": [
            {
              "off": "q.mark_variant == 99 || !q.is_alive"
            }
          ]
        },
        "off": {
          "transitions": [
            {
              "light": "q.mark_variant != 99 && q.is_alive && q.skin_id == 0"
            },
            {
              "heavy": "q.mark_variant != 99 && q.is_alive && q.skin_id >= 1"
            }
          ]
        }
      }
    },
    "controller.animation.hitori.attack_fx": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "swing": "variable.attack_time > 0.25"
            }
          ]
        },
        "swing": {
          "particle_effects": [
            {
              "effect": "hand",
              "locator": "right_hand"
            }
          ],
          "transitions": [
            {
              "ready": "variable.attack_time < 0.2"
            }
          ]
        }
      }
