    "controller.animation.hitori.cooldown": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "cd": "q.is_sheared"
            }
          ]
        },
        "cd": {
          "animations": [
            "cd_timer"
          ],
          "transitions": [
            {
              "ready": "q.all_animations_finished || !q.is_sheared"
            }
          ],
          "on_exit": [
            "@s hitori:cd_end"
          ]
        }
      }
    },
    "controller.animation.hitori.death": {
      "initial_state": "alive",
      "states": {
        "alive": {
          "transitions": [
            {
              "dead": "!q.is_alive"
            }
          ]
        },
        "dead": {
          "on_entry": [
            "/tellraw @a[r=48] {\"rawtext\":[{\"text\":\"§b独§7「……あーあ。バグ、直されちゃった」\"}]}",
            "/particle hitori:noise_big ~ ~1 ~",
            "/particle hitori:error_popup ~ ~1 ~",
            "/particle hitori:shockwave_big ~ ~0.1 ~",
            "/playsound beacon.deactivate @a[r=64] ~ ~ ~ 1 0.5",
            "/scoreboard players reset @s hitori_glitch"
          ]
        }
      }
