    "controller.animation.hitori.cooldown": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "cd": "q.is_sheared"
            }
          ]
        },
        "cd": {
          "animations": [
            "cd_timer"
          ],
          "transitions": [
            {
              "ready": "q.all_animations_finished || !q.is_sheared"
            }
          ],
          "on_exit": [
            "@s hitori:cd_end"
          ]
        }
      }
    },
    "controller.animation.hitori.reboot": {
      "initial_state": "ready",
      "states": {
        "ready": {
          "transitions": [
            {
              "rb": "q.is_charged"
            }
          ]
        },
        "rb": {
          "animations": [
            "reboot_timer"
          ],
          "transitions": [
            {
              "ready": "q.all_animations_finished || !q.is_charged"
            }
          ],
          "on_exit": [
            "@s hitori:reboot_end"
          ]
        }
      }
    },
    "controller.animation.hitori.death": {
      "initial_state": "alive",
      "states": {
        "alive": {
          "transitions": [
            {
              "dead": "!q.is_alive"
            }
          ]
        },
        "dead": {
          "on_entry": [
            "/summon hitori:director ~ ~ ~",
            "/scoreboard players reset @s hitori_glitch",
            "/camera @a[tag=hitori_cine] clear",
            "/hud @a[tag=hitori_cine] reset all",
            "/tag @a[tag=hitori_cine] remove hitori_cine",
            "/tag @s remove vb_cine",
            "/execute unless entity @e[tag=vb_cine,r=64] run event entity @e[family=rival_boss,tag=vb_paused,r=64] vb:resume"
          ]
        }
      }
    },
    "controller.animation.hitori.bgm": {
      "initial_state": "start",
      "states": {
        "start": {
          "transitions": [
            {
              "dive": "q.skin_id >= 1"
            },
            {
              "memory": "q.skin_id == 0"
            }
          ]
        },
        "memory": {
          "on_entry": [
            "/music play hitori.bgm.kakuzetsu 0.9 2 loop"
          ],
          "transitions": [
            {
              "end": "!q.is_alive"
            },
            {
              "dive": "q.skin_id >= 1"
            }
          ]
        },
        "dive": {
          "on_entry": [
            "/music play hitori.bgm.freedom_dive 1.0 1 loop"
          ],
          "transitions": [
            {
              "end": "!q.is_alive"
            }
          ]
        },
        "end": {
          "on_entry": [
            "/music stop 4"
          ]
        }
      }
    },
    "controller.animation.hitori.gravity_cube": {
      "initial_state": "fall",
      "states": {
        "fall": {
          "animations": [
            "life"
          ],
          "transitions": [
            {
              "boom": "q.is_on_ground"
            }
          ]
        },
        "boom": {
          "on_entry": [
            "/damage @a[r=2.8,m=!creative] 14 entity_explosion",
            "/damage @e[family=rival_boss,type=!hitori:denshi_hitori,tag=!vb_cine,tag=!vb_paused,r=2.8] 14 entity_attack entity @e[type=hitori:denshi_hitori,c=1]",
            "/particle hitori:missing_burst ~ ~0.5 ~",
            "/particle hitori:noise_big ~ ~0.5 ~",
            "/particle hitori:shockwave ~ ~0.1 ~",
            "/particle hitori:fall_pixels ~ ~ ~",
            "/playsound random.explode @a[r=24] ~ ~ ~ 0.8 1.4",
            "/camerashake add @a[r=10] 0.5 0.3 positional",
            "@s hitori:despawn"
          ]
        }
      }
    },
    "controller.animation.hitori.echo": {
      "initial_state": "pick",
      "states": {
        "pick": {
          "transitions": [
            {
              "o0": "q.variant == 0"
            },
            {
              "o1": "q.variant == 1"
            },
            {
              "o2": "q.variant == 2"
            },
            {
              "o3": "q.variant == 3"
            }
          ]
        },
        "o0": {
          "animations": [
            "orbit_0"
          ]
        },
        "o1": {
          "animations": [
            "orbit_1"
          ]
        },
        "o2": {
          "animations": [
            "orbit_2"
          ]
        },
        "o3": {
          "animations": [
            "orbit_3"
          ]
        }
      }
    }
  }
