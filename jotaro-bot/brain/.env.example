# このファイルを .env という名前でコピーして使う。

# 考える方式を選ぶ。
#   claude-code : Claude Code のログインを使う。Pro / Max プランの利用枠で動き、APIキーは不要。
#   api         : APIキーを使う(従量課金)。
BACKEND=claude-code

# ── BACKEND=claude-code のとき ──
# 使うモデル。haiku が最も枠を消費しにくい。sonnet / opus も指定できる。空にすると Claude Code の既定。
CLAUDE_CODE_MODEL=haiku
# claude コマンドが見つからないと言われたときだけ、claude.exe の場所を書く(例: C:\\Users\\あなたの名前\\.local\\bin\\claude.exe)
CLAUDE_PATH=

# ── BACKEND=api のとき ──
# キーは https://platform.claude.com/ で発行する。
ANTHROPIC_API_KEY=

# APIで使うモデル。賢さと料金のバランスで選ぶ。
#   claude-opus-5-5   (標準。賢い)
#   claude-sonnet-5-5 (やや安い)
#   claude-haiku-5-5  (とても安い。反応も速いが判断は粗い)
MODEL=claude-opus-5-5

# 考える深さ。low が最も速くて安い。low / medium / high
EFFORT=low

# 何も起きていないときに、自分から次の行動を考える間隔(秒)。長いほど安い。
IDLE_SECONDS=60

# 1時間あたりのAPI呼び出し回数の上限(使いすぎ防止)
MAX_CALLS_PER_HOUR=300

# 体側(behavior_pack/scripts/config.js の brainUrl)と同じポート番号にする
PORT=3920
